<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>dev.thatonedev.companion</AssemblyName>
    <RootNamespace>dev.thatonedev.companion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <!-- Explicitly set the NuGet package cache folder path for Linux CI runners -->
    <GameLibsDir>$(UserProfile)\.nuget\packages\amongus.gamelibs.steam\2023.10.24\lib\netstandard2.1</GameLibsDir>
  </PropertyGroup>

  <!-- Fallback path adjustment for Linux runners (forward slashes) -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <GameLibsDir>$([System.Environment]::GetFolderPath(SpecialFolder.UserProfile))/.nuget/packages/amongus.gamelibs.steam/2023.10.24/lib/netstandard2.1</GameLibsDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.679" />
    <PackageReference Include="Reactor" Version="2.3.1" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.4.6-ci.389" />
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2023.10.24" />
  </ItemGroup>

  <!-- Direct file references using the evaluated properties -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameLibsDir)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameLibsDir)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="MiraAPI">
      <HintPath>libs\MiraAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
