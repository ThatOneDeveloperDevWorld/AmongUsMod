<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>dev.thatonedev.companion</AssemblyName>
    <RootNamespace>dev.thatonedev.companion</RootNamespace>
    <LangVersion>latest</LangVersion>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Samboy063.LibCpp2IL" Version="2022.1.0-pre-release.13" />
    <PackageReference Include="StableNameDotNet" Version="0.1.0-pre-release.13" />
    <PackageReference Include="BepInEx.Unity.IL2CPP" Version="6.0.0-be.679" />
    <PackageReference Include="Reactor" Version="2.3.1" />
    <PackageReference Include="Il2CppInterop.Runtime" Version="1.4.6-ci.389" />
    <PackageReference Include="AmongUs.GameLibs.Steam" Version="2023.10.24" GeneratePathProperty="true" />
  </ItemGroup>

  <PropertyGroup>
    <GameLibsPath>$(PkgAmongUs_GameLibs_Steam)</GameLibsPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameLibsPath)/lib/netstandard2.1/Assembly-CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameLibsPath)/lib/netstandard2.1/UnityEngine.CoreModule.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="MiraAPI">
      <HintPath>libs\MiraAPI.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
